---
import '@/styles/global.scss';
import SettingsInit from '@/app/components/SettingsInit/SettingsInit.astro';
import Header from '@/app/components/Header/Header.astro';
import Footer from '@/app/components/Footer/Footer.astro';
import PageIndicator from '@/app/components/PageIndicator/PageIndicator.astro';
import { getCurrentPageInfo } from '@/config/pages';
import SettingsDialog from '@/features/settings/SettingsDialog/SettingsDialog.astro';
import ProjectDialog from '@/features/projects/components/ProjectDialog/ProjectDialog';
import { getProjects } from '@/lib/github';
import SidebarPageIndicator from '@/app/components/SidebarPageIndicator/SidebarPageIndicator.astro';
import { ClientRouter } from 'astro:transitions';
import NotchedBorder from '@/app/components/NotchedBorder/NotchedBorder.astro';
import Background from '@/app/components/Background/Background.astro';
import { defaultLanguage } from '@/i18n/config';
import type { Language } from '@/types/Language';

interface Props {
  lang?: Language;
  title: string;
  pageHref: string;
}

const { lang, title, pageHref } = Astro.props;

const currentPageInfo = getCurrentPageInfo(pageHref);
const { projects } = await getProjects();

const language = lang ?? defaultLanguage;
---

<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <SettingsInit />
  </head>
  <body>
    <Background />
    <div class="app">
      <SidebarPageIndicator pageInfo={currentPageInfo} />
      <Header currentPath={pageHref} />
      <main>
        <div class="container">
          <PageIndicator pageInfo={currentPageInfo} />
          <slot />
        </div>
        <NotchedBorder class="notched-border" />
      </main>
      <Footer />
      <SettingsDialog />
      <ProjectDialog {projects} client:load />
    </div>
  </body>
</html>

<script>
  document.addEventListener('astro:before-swap', ({ newDocument }) => {
    // The hydration error happened because an Emotion <style> tag remained inside the incoming page’s React markup during Astro navigation. The layout script moves those tags into <head> before hydration, where they can still style the select without interfering with React’s expected HTML.
    newDocument.body.querySelectorAll('style[data-emotion]').forEach((style) => {
      newDocument.head.appendChild(style);
    });
  });
</script>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/breakpoints' as bp;

  body {
    display: flex;
    justify-content: center;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
  }

  .app {
    isolation: isolate;
    width: min(100%, bp.$breakpoint-desktop-lg);
    min-height: 0;
    display: flex;
    flex-direction: column;
    position: relative;

    @include bp.desktop {
      margin-inline: 1rem;
    }
  }

  main {
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border: 1px solid $border-secondary;
    border-top: 0;
    padding: 0.5rem;

    @include bp.desktop {
      border-right: 0;

      &:has([data-ignore-padding]) {
        padding: 0;
        border-bottom: 0;
      }
    }
  }

  .notched-border {
    display: none;
    @include bp.desktop {
      display: block;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    width: min(100%, bp.$breakpoint-desktop-md);

    @include bp.desktop {
      padding-inline: 1rem;

      &:has([data-ignore-padding]) {
        width: 100%;
        padding: 0;
      }
    }
  }
</style>
