---
import '@/styles/global.scss';
import ThemeInit from '@/app/components/ThemeInit/ThemeInit.astro';
import Header from '@/app/components/Header/Header.astro';
import Footer from '@/app/components/Footer/Footer.astro';
import PageIndicator from '@/app/components/PageIndicator/PageIndicator.astro';
import { getCurrentPageInfo } from '@/config/pages';
import SettingsDialog from '@/features/settings/SettingsDialog/SettingsDialog.astro';
import ProjectDialog from '@/features/projects/components/ProjectDialog/ProjectDialog';
import { getProjects } from '@/lib/github';
import SidebarPageIndicator from '../components/SidebarPageIndicator/SidebarPageIndicator.astro';
import { ClientRouter } from 'astro:transitions';
import NotchedBorder from '../components/NotchedBorder/NotchedBorder.astro';

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const currentPageInfo = getCurrentPageInfo(currentPath);
const { projects } = await getProjects();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <ThemeInit />
  </head>
  <body>
    <div class="app">
      <SidebarPageIndicator pageInfo={currentPageInfo} />
      <Header />
      <main>
        <div class="container">
          <PageIndicator pageInfo={currentPageInfo} />
          <slot />
        </div>
        <NotchedBorder class="notched-border" />
      </main>
      <Footer />
      <SettingsDialog />
      <ProjectDialog {projects} client:load />
    </div>
  </body>
</html>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/breakpoints' as bp;

  body {
    display: flex;
    justify-content: center;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
  }

  .app {
    width: min(100%, bp.$breakpoint-desktop-lg);
    min-height: 0;
    display: flex;
    flex-direction: column;
    position: relative;

    @include bp.desktop {
      margin-inline: 1rem;
    }
  }

  main {
    position: relative;
    display: flex;
    align-items: center;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border: 1px solid $border-secondary;
    border-top: 0;
    padding: 0.5rem;

    @include bp.desktop {
      border-right: 0;

      &:has([data-ignore-padding]) {
        padding: 0;
        border-bottom: 0;
      }
    }
  }

  .notched-border {
    display: none;
    @include bp.desktop {
      display: block;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    width: min(100%, bp.$breakpoint-desktop-md);

    @include bp.desktop {
      padding-inline: 1rem;

      &:has([data-ignore-padding]) {
        width: 100%;
        padding: 0;
      }
    }
  }
</style>
