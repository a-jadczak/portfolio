---
import styles from './SidebarPageIndicator.module.scss';
import type { PageInfo } from '@/types/PageInfo';

interface Props {
  pageInfo: PageInfo;
}

const {
  pageInfo: { name, indicator },
}: Props = Astro.props;
---

<div class={styles.sidebar}>
  <span class={styles.index}>{indicator} </span>
  <span class={styles.upsideDownText}>{name}</span>
</div>
