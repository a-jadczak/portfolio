---
import styles from './HeaderSvg.module.scss';
---

<div class={styles.container}>
  <div class={styles.navbarBorder}>
    <!-- Left -->
    <svg viewBox="0 0 32 85">
      <path d="M32 0.5 H7.5 L0.5 7.5 V84.5 H32"></path>
    </svg>

    <!-- Center -->
    <svg viewBox="0 0 100 85" preserveAspectRatio="none">
      <rect x="0" y="0.5" width="100" height="84"></rect>
      <path d="M0 0.5 H100 M0 84.5 H100"></path>
    </svg>

    <!-- Right -->
    <svg viewBox="0 0 360 85">
      <path d="M0 0.5 H15 L69.5 55 H330.5 L359.5 84.5 H0"></path>
    </svg>
  </div>
  <div class={styles.content}>
    <slot />
  </div>
</div>
