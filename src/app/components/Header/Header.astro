---
import HeaderLogo from './components/HeaderLogo/HeaderLogo';
import MobileMenu from './components/MobileMenu/MobileMenu';
import TabletMenu from './components/TabletMenu/TabletMenu';
import styles from './Header.module.scss';

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<header class={`clipped-corners-top ${styles.header}`}>
  <HeaderLogo />
  <MobileMenu className={styles.mobileMenu} currentPath={currentPath} client:load />
  <TabletMenu className={styles.tabletMenu} currentPath={currentPath} client:load />
</header>
