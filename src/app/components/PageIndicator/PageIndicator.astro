---
import Text from '@/components/ui/Text/Text';
import styles from './PageIndicator.module.scss';
import type { PageInfo } from '@/types/PageInfo';

interface Props {
  pageInfo: PageInfo;
}

const {
  pageInfo: { name, indicator },
}: Props = Astro.props;
---

<Text className={styles.textIndicator}>
  <span class={styles.index}>{indicator} </span>
  / {name}
</Text>
