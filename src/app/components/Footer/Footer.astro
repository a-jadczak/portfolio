---
import { fullName } from '@/config/me';
import styles from './Footer.module.scss';
import Text from '@/components/ui/Text/Text';

const t = Astro.locals.i18n.t.footer;
---

<footer class={styles.footer}>
  <Text size="extra-small" variant="muted">
    © {new Date().getFullYear()}{' '}
    {fullName} · {t.rightsReserved}
  </Text>
</footer>
