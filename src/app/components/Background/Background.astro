<div class="background" data-flow-background aria-hidden="true"><canvas></canvas></div>
<script>
  let disposeBackground: (() => void) | undefined;

  function initializeBackground() {
    disposeBackground?.();
    const root = document.querySelector<HTMLElement>('[data-flow-background]');
    if (!root) return;
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const context = ctx;
    let colors: string[] = [];
    let blend: GlobalCompositeOperation = 'screen';
    function refreshColors() {
      const styles = getComputedStyle(root!);
      colors = [1, 2, 3].map((index) => styles.getPropertyValue(`--ribbon-${index}`).trim());
      blend = styles.getPropertyValue('--ribbon-blend').trim() as GlobalCompositeOperation;
    }
    refreshColors();
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    function isReducedMotion() {
      return document.documentElement.dataset.reducedMotion === 'true' || motion.matches;
    }
    let width = 1,
      height = 1,
      time = 0,
      previous = 0,
      frame = 0;
    let visible = true;
    let disposed = false;
    // Fixed sampling keeps geometry work independent of viewport width.
    const steps = 160;
    let gradients: CanvasGradient[][] = [];
    function refreshGradients() {
      gradients = ribbons.map((ribbon, ribbonIndex) =>
        Array.from({ length: ribbon.count }, (_, line) => {
          const center = (ribbon.count - 1) / 2;
          const strength = 1 - Math.abs(line - center) / (center + 1);
          const alpha = 0.085 + strength * 0.24;
          const color = colors[ribbonIndex];
          const gradient = context.createLinearGradient(0, 0, width, 0);
          gradient.addColorStop(0, `color-mix(in srgb, ${color} 0%, transparent)`);
          gradient.addColorStop(0.18, `color-mix(in srgb, ${color} ${alpha * 100}%, transparent)`);
          gradient.addColorStop(0.55, `color-mix(in srgb, ${color} ${alpha * 55}%, transparent)`);
          gradient.addColorStop(0.84, `color-mix(in srgb, ${color} ${alpha * 100}%, transparent)`);
          gradient.addColorStop(1, `color-mix(in srgb, ${color} 0%, transparent)`);
          return gradient;
        })
      );
    }
    const ribbons = [
      { base: 0.23, slope: 0.28, amplitude: 0.15, phase: 0.2, count: 19 },
      { base: 0.76, slope: -0.28, amplitude: 0.13, phase: 2.7, count: 17 },
      { base: 0.55, slope: 0.38, amplitude: 0.12, phase: 4.1, count: 13 },
    ];
    function sampleRibbon(ribbon: (typeof ribbons)[number]) {
      return Array.from({ length: steps + 1 }, (_, i) => {
        const u = i / steps;
        const phase = ribbon.phase;
        const wave = Math.sin(u * 5.1 + time * 0.22 + phase) * ribbon.amplitude;
        const detail = Math.sin(u * 8.7 - time * 0.13 + phase) * 0.025;
        return {
          x: u * (width + 60) - 30,
          y: (ribbon.base + (u - 0.5) * ribbon.slope + wave + detail) * height,
          spread: (0.0038 + 0.0035 * (1 + Math.sin(u * 5.5 + time * 0.12 + phase))) * height,
        };
      });
    }
    function path(samples: ReturnType<typeof sampleRibbon>, offset: number) {
      context.beginPath();
      samples.forEach(({ x, y, spread }, i) => {
        const lineY = y + offset * spread;
        if (i === 0) context.moveTo(x, lineY);
        else context.lineTo(x, lineY);
      });
    }
    function draw() {
      context.clearRect(0, 0, width, height);
      context.globalCompositeOperation = blend;
      for (const [ribbonIndex, ribbon] of ribbons.entries()) {
        const color = colors[ribbonIndex];
        const samples = sampleRibbon(ribbon);
        // A broad, faint stroke produces the halo without expensive blur filters.
        path(samples, 0);
        context.strokeStyle = `color-mix(in srgb, ${color} 2.4%, transparent)`;
        context.lineWidth = height * 0.11;
        context.stroke();
        for (let line = 0; line < ribbon.count; line++) {
          path(samples, line - (ribbon.count - 1) / 2);
          context.strokeStyle = gradients[ribbonIndex][line];
          context.lineWidth = line % 6 === 0 ? 1.05 : 0.6;
          context.stroke();
        }
      }
      context.globalCompositeOperation = 'source-over';
    }
    function tick(stamp: number) {
      frame = 0;
      if (disposed || !root!.isConnected || !visible || document.hidden || isReducedMotion()) {
        previous = 0;
        return;
      }
      if (previous) time += Math.min((stamp - previous) / 1000, 1 / 30);
      previous = stamp;
      draw();
      frame = requestAnimationFrame(tick);
    }
    function sync() {
      cancelAnimationFrame(frame);
      frame = 0;
      previous = 0;
      if (disposed || !root!.isConnected || !visible || document.hidden) return;
      if (isReducedMotion()) draw();
      else frame = requestAnimationFrame(tick);
    }
    const resize = new ResizeObserver(() => {
      const box = root.getBoundingClientRect();
      width = Math.max(1, box.width);
      height = Math.max(1, box.height);
      // Bound the backing-store cost on large and high-density displays.
      const dpr = Math.min(devicePixelRatio || 1, 2, Math.sqrt(2_000_000 / (width * height)));
      const pixelWidth = Math.round(width * dpr);
      const pixelHeight = Math.round(height * dpr);
      if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
      if (canvas.height !== pixelHeight) canvas.height = pixelHeight;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      refreshGradients();
      sync();
    });
    resize.observe(root);
    const visibility = new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      sync();
    });
    visibility.observe(root);
    document.addEventListener('visibilitychange', sync);
    motion.addEventListener('change', sync);
    const themeObserver = new MutationObserver(() => {
      refreshColors();
      refreshGradients();
      sync();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'style', 'class', 'data-reduced-motion'],
    });
    const systemTheme = matchMedia('(prefers-color-scheme: dark)');
    function updateTheme() {
      refreshColors();
      refreshGradients();
      sync();
    }
    systemTheme.addEventListener('change', updateTheme);
    function dispose() {
      disposed = true;
      cancelAnimationFrame(frame);
      resize.disconnect();
      visibility.disconnect();
      themeObserver.disconnect();
      document.removeEventListener('visibilitychange', sync);
      motion.removeEventListener('change', sync);
      systemTheme.removeEventListener('change', updateTheme);
      document.removeEventListener('astro:before-swap', dispose);
    }
    disposeBackground = dispose;
    document.addEventListener('astro:before-swap', dispose, { once: true });
  }
  document.addEventListener('astro:page-load', initializeBackground);
</script>

<style lang="scss">
  @use '../../../styles/tokens' as *;

  .background {
    --ribbon-1: #{$primary};
    --ribbon-2: #{$primary-dark};
    --ribbon-3: #{$primary-light};
    --ribbon-blend: source-over;
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    isolation: isolate;
    background: $background;

    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    &::before {
      background:
        radial-gradient(
          ellipse at 3% 20%,
          color-mix(in srgb, $primary 13%, transparent),
          transparent 52%
        ),
        radial-gradient(
          ellipse at 95% 80%,
          color-mix(in srgb, $primary-dark 14%, transparent),
          transparent 53%
        );
    }
    canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    &::after {
      background:
        radial-gradient(
          ellipse at 50% 45%,
          color-mix(in srgb, #{$background} 33%, transparent),
          transparent 65%
        ),
        linear-gradient(
          0deg,
          color-mix(in srgb, #{$background} 53%, transparent),
          transparent 18%,
          transparent 82%,
          color-mix(in srgb, #{$background} 53%, transparent)
        );
    }
  }
  :global([data-theme='dark']) .background {
    --ribbon-blend: screen;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .background {
      --ribbon-blend: screen;
    }
  }
</style>
