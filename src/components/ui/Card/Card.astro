---
import type { HTMLAttributes } from 'astro/types';
import styles from './Card.module.scss';

type Props = HTMLAttributes<'div'> & {
  border?: boolean;
};

const { border = true, class: className, 'class:list': classList, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class:list={['clipped-corners', styles.card, border && styles.bordered, className, classList]}
>
  <slot />
</div>
