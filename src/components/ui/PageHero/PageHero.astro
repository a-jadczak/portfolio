---
import Eyebrow from '@/components/ui/Eyebrow/Eyebrow.astro';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import styles from './PageHero.module.scss';

interface Props {
  class?: string;
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
---

<section class:list={[styles.section, className]}>
  <header class={styles.header}>
    <Eyebrow>{eyebrow}</Eyebrow>
    <Heading as="h1" size="large">{title}</Heading>
    <Text size="large" variant="secondary">{description}</Text>
  </header>

  <slot />
</section>
