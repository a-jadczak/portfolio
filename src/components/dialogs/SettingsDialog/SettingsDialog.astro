---
import styles from './SettingsDialog.module.scss';
import { Moon, Settings, Sun, X } from 'lucide-react';
import ColorPickerList from './components/ColorPickerList/ColorPickerList';
import SettingsField from './components/SettingsField/SettingsField.astro';
import Heading from '@/components/ui/Heading/Heading.astro';
import SegmentedControl from '@/components/ui/SegmentedControl/SegmentedControl';
import Divider from '@/components/ui/Divider/Divider.astro';
import Text from '@/components/ui/Text/Text.astro';
import Button from '@/components/ui/Button/Button';
import Toggle from '@/components/ui/Toggle/Toggle';

const colors = ['red', 'lawngreen', 'blue', 'purple'];
---

<!-- for testing -->
<script>
  document.querySelector('dialog')?.showModal();
</script>

<dialog class={`clipped-corners ${styles.dialog}`} aria-labelledby="settings-title">
  <header class={styles.header}>
    <Settings size={28} aria-hidden="true" />
    <Heading as="h2" size="small" id="settings-title">Settings</Heading>
    <Button
      as="button"
      variant="default"
      Icon={X}
      aria-hidden="true"
      style={{ padding: '0.5rem' }}
    />
  </header>
  <Divider />
  <SettingsField title="Theme">
    <SegmentedControl
      options={[
        { Icon: Sun, text: 'Light' },
        { Icon: Moon, text: 'Dark' },
      ]}
      value={'Dark'}
    />
  </SettingsField>
  <SettingsField title="Language">
    <SegmentedControl
      client:load
      options={[{ text: 'Polski' }, { text: 'English' }]}
      value={'English'}
    />
  </SettingsField>
  <div class={styles.toggleContainer}>
    <label>Reduce motion</label>
    <Toggle client:load aria-label="Reduce motion" className={styles.toggle} />
    <Text variant="secondary" size="small">Disable interface animations</Text>
  </div>
  <Divider />
  <!-- <SettingsField title="Reduce motion">

  </SettingsField> -->
  <SettingsField title="Accent color">
    <ColorPickerList client:load colors={colors} />
  </SettingsField>
  <button type="button" class={styles.systemPreferences}>Use system preferences</button>
</dialog>
