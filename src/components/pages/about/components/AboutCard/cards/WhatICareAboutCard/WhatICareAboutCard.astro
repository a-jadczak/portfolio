---
import Card from '@/components/cards/Card/Card.astro';
import styles from './WhatICareAboutCard.module.scss';
import Heading from '@/components/ui/Heading/Heading.astro';
import Text from '@/components/ui/Text/Text.astro';
import { cards } from './WhatICareAboutCard.data';
import CardIcon from '@/components/cards/CardIcon/CardIcon.astro';
---

<div class={styles.gridContainer}>
  {
    cards.map(({ title, Icon, description, image }) => (
      <Card class={styles.card} style={`--card-image: url("${image}")`}>
        <header>
          <CardIcon Icon={Icon} />
          <Heading class={styles.title} as="h3">
            {title}
          </Heading>
        </header>
        <Text variant="secondary">{description}</Text>
      </Card>
    ))
  }
</div>
