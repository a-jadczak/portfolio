---
import Card from '@/components/cards/Card/Card.astro';
import CardIcon from '@/components/cards/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading.astro';
import Text from '@/components/ui/Text/Text.astro';
import Timeline from '@/components/ui/Timeline/Timeline.astro';
import TimelineItem from '@/components/ui/Timeline/TimelineItem.astro';
import { CodeXml, Image, Lightbulb, NotebookPen } from 'lucide-react';
import styles from './WorkflowCard.module.scss';

const workflowCards = [
  {
    Icon: Lightbulb,
    title: 'Idea',
    description: 'Lorem ipsum dolor sit amet consectetur adipisicing',
  },
  {
    Icon: NotebookPen,
    title: 'Research & Planning',
    description:
      'Lorem ipsum dolor sit amet consectetur adipisicing elit. Quidem ea doloribus aliquam dolores nam. Laudantium distinctio maxime consequatur assumenda impedit!',
  },
  {
    Icon: Image,
    title: 'Visual Generation',
    description: 'Lorem ipsum dolor sit amet consectetur adipisicing ',
  },
  {
    Icon: CodeXml,
    title: 'Implementation',
    description:
      'Lorem ipsum dolor sit amet consectetur adipisicing elit. Quidem ea doloribus aliquam',
  },
];
---

<Timeline>
  {
    workflowCards.map(({ Icon, title, description }) => (
      <TimelineItem>
        <Card class={styles.card}>
          <CardIcon Icon={Icon} />
          <div>
            <Heading as="h3" size="extra-small">
              {title}
            </Heading>
            <Text size="extra-small" variant="secondary">
              {description}
            </Text>
          </div>
        </Card>
      </TimelineItem>
    ))
  }
</Timeline>
