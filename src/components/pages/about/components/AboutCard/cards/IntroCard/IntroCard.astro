---
import Card from '@/components/cards/Card/Card.astro';
import Heading from '@/components/ui/Heading/Heading.astro';
import { MapPin, CircleCheck, Languages } from 'lucide-react';
import Text from '@/components/ui/Text/Text.astro';
import styles from './IntroCard.module.scss';
---

<Heading as="h1">Lorem ipsum dolor sit.</Heading>
<Text variant="secondary">
  Lorem ipsum dolor sit amet, consectetur adipisicing elit. Veniam hic velit cupiditate voluptatem
  dolorem assumenda accusamus saepe asperiores illum. Repellat.
</Text>
<Card>
  <ul class={styles.infoList}>
    <li class={styles.infoElement}>
      <MapPin className={styles.infoIcon} />
      <span class={styles.infoLabel}>Based in</span>
      <span class={styles.infoContent}>Poland / Remote</span>
    </li>
    <li class={styles.infoElement}>
      <CircleCheck className={styles.infoIcon} />
      <span class={styles.infoLabel}>Status</span>
      <span class={styles.infoContent}>Open to opportunites</span>
    </li>
    <li class={styles.infoElement}>
      <Languages className={styles.infoIcon} />
      <span class={styles.infoLabel}>Languages</span>
      <span class={styles.infoContent}>Polish / English</span>
    </li>
  </ul>
</Card>
