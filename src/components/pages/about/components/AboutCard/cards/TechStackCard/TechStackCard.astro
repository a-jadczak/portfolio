---
import Card from '@/components/cards/Card/Card.astro';
import CardIcon from '@/components/cards/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading.astro';
import StackItem from './components/StackItem/StackItem.astro';
import styles from './TechStackCard.module.scss';
import { techStack } from './TechStackCard.data';
import { AppWindow, BookOpen, Bot, Database, FlaskConical, Shapes, Wrench } from 'lucide-react';

const icons = new Map([
  ['frontend', AppWindow],
  ['backend', Database],
  ['tools', Wrench],
  ['testing', FlaskConical],
  ['AI', Bot],
  ['others', Shapes],
  ['familiar with', BookOpen],
]);
---

<ul class={styles.categoryList}>
  {
    techStack.keys().map((key) => (
      <li>
        <Card>
          <header class={styles.header}>
            <CardIcon Icon={icons.get(key)} />
            <Heading size="small" as="h3" class={styles.title}>
              {key}
            </Heading>
          </header>
          <ul class={styles.techList}>
            {techStack.get(key)!.map((item) => (
              <li>
                <StackItem {...item} />
              </li>
            ))}
          </ul>
        </Card>
      </li>
    ))
  }
</ul>
