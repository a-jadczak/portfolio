---
import { ArrowRight } from 'lucide-react';
import styles from './FeaturedProjects.module.scss';
import Project from '@/components/ui/Project/Project.astro';
---

<article class={`clipped-corners ${styles.featuredProjects}`}>
  <div class={styles.titleContainer}>
    <h2>Featured Projects</h2>
    <a style={styles.link} href="/projects">
      <span>View all</span>
      <ArrowRight className={styles.buttonContentIcon} size={18} />
    </a>
  </div>
  <ol class={styles.projectsList}>
    <Project />
  </ol>
</article>
