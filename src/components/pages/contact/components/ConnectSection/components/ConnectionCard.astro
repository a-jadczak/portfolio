---
import styles from './ConnectionCard.module.scss';

const { icon: Icon, title, description } = Astro.props;
---

<div class={`clipped-corners ${styles.container}`}>
  <div class={`clipped-corners ${styles.iconContainer}`} aria-hidden={true}>
    <Icon size={32} />
  </div>
  <div class={styles.contentContainer}>
    <h3 class={styles.title}>{title}</h3>
    <p class={styles.description}>{description}</p>
  </div>
</div>
