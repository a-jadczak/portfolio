---
import { FolderOpen, Home, Mail, User } from 'lucide-react';
import styles from './NavigationMenu.module.scss';

const ICON_SIZE = 20;
---

<nav class={styles.navigation} aria-label="Navigation">
  <ul class={styles.navigationList}>
    <li class={styles.navigationItem}>
      <a href="/" class={styles.navigationLink}>
        <span class={styles.navigationContent}>
          <Home className={styles.navigationIcon} size={ICON_SIZE} aria-hidden="true" />
          <span class={styles.navigationText}>Home</span>
        </span>
      </a>
    </li>
    <li class={styles.navigationItem}>
      <a href="/About" class={styles.navigationLink}>
        <span class={styles.navigationContent}>
          <User className={styles.navigationIcon} size={ICON_SIZE} aria-hidden="true" />
          <span class={styles.navigationText}>About</span>
        </span>
      </a>
    </li>
    <li class={styles.navigationItem}>
      <a href="/Projects" class={styles.navigationLink}>
        <span class={styles.navigationContent}>
          <FolderOpen className={styles.navigationIcon} size={ICON_SIZE} aria-hidden="true" />
          <span class={styles.navigationText}>Projects</span>
        </span>
      </a>
    </li>
    <li class={styles.navigationItem}>
      <a href="/Contact" class={styles.navigationLink}>
        <span class={styles.navigationContent}>
          <Mail className={styles.navigationIcon} size={ICON_SIZE} aria-hidden="true" />
          <span class={styles.navigationText}>Contact</span>
        </span>
      </a>
    </li>
  </ul>
</nav>
