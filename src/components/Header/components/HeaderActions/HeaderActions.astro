---
import { FaGithub, FaLinkedin } from 'react-icons/fa';
import ExternalLink from './components/ExternalLink/ExternalLink.astro';
import ResumeLink from './components/ResumeLink/ResumeLink.astro';
import SettingsButton from './components/SettingsButton/SettingsButton.astro';
import styles from './HeaderActions.module.scss';

const ICON_SIZE = 18;
const externalLinks = [
  { href: 'https://github.com/a-jadczak', label: 'GitHub', Icon: FaGithub },
  {
    href: 'https://www.linkedin.com/in/arkadiusz-jadczak-27458b42b/',
    label: 'LinkedIn',
    Icon: FaLinkedin,
  },
];
---

<div class={styles.externalContainer}>
  <ul class={styles.externalList}>
    {
      externalLinks.map((link) => (
        <li class={styles.externalItem}>
          <ExternalLink {...link} iconSize={ICON_SIZE} />
        </li>
      ))
    }
    <li class={styles.externalItem}>
      <SettingsButton iconSize={ICON_SIZE} />
    </li>
  </ul>

  <ResumeLink href="/resume.pdf" />
</div>
