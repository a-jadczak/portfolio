---
import type { IconType } from 'react-icons';
import styles from './../IconAction.module.scss';

interface Props {
  href: string;
  label: string;
  Icon: IconType;
  iconSize: number;
}

const { href, label, Icon, iconSize }: Props = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={['clipped-corners', styles.iconAction]}
  aria-label={label}
>
  <Icon size={iconSize} aria-hidden="true" />
</a>
