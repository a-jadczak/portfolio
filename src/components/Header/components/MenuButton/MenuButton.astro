---
import { Menu } from 'lucide-react';
import styles from './MenuButton.module.scss';
---

<button
  type="button"
  class:list={['clipped-corners', styles.menuButton]}
  aria-label="Open menu"
  aria-controls="navigation-menu"
  aria-expanded="true"
>
  <Menu size={24} aria-hidden="true" />
</button>
