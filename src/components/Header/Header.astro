---
import HeaderLogo from './components/MobileMenu/components/HeaderLogo/HeaderLogo';
import MobileMenu from './components/MobileMenu/MobileMenu';

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<header>
  <HeaderLogo />
  <MobileMenu currentPath={currentPath} client:load />
</header>
