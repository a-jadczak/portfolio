---
import styles from './PageIndicator.module.scss';
import type { PageInfo } from '@/types/PageInfo';

interface Props {
  pageInfo: PageInfo;
}

const {
  pageInfo: { name, index },
}: Props = Astro.props;
---

<p class={styles.sidebar}>
  <span class={styles.index}>0{index + 1} </span>
  / {name}
</p>
