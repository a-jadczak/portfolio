---
import Card from '@/components/ui/Card/Card.astro';
import CardIcon from '@/components/ui/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading';
import StackItem from '@/features/about/components/StackItem/StackItem.astro';
import styles from './TechStackCard.module.scss';
import { techStack } from '@/features/about/data/tech-stack';
import { techStackIcons } from '@/features/about/data/tech-stack-icons';
import Divider from '@/components/ui/Divider/Divider';

const t = Astro.locals.i18n.t.pages.about.techStack;
---

<div class={styles.categoryListContainer}>
  <ul class={styles.categoryList}>
    {
      techStack.keys().map((key) => (
        <li>
          <Card border={false}>
            <header class={styles.header}>
              <CardIcon Icon={techStackIcons.get(key)} size={24} class={styles.cardIcon} />
              <Heading size="extra-small" as="h3" className={styles.title}>
                {t.categories[key as keyof typeof t.categories]}
              </Heading>
            </header>
            <Divider />
            <ul class={styles.techList}>
              {techStack.get(key)!.map((item) => (
                <li>
                  <StackItem {...item} />
                </li>
              ))}
            </ul>
          </Card>
        </li>
      ))
    }
  </ul>
</div>
