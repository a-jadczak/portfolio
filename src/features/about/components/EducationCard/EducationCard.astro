---
import Card from '@/components/ui/Card/Card.astro';
import CardIcon from '@/components/ui/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import Timeline from '@/components/ui/Timeline/Timeline.astro';
import TimelineItem from '@/components/ui/Timeline/TimelineItem.astro';
import { GraduationCap, School } from 'lucide-react';
import styles from './EducationCard.module.scss';

const experiences = [
  {
    Icon: School,
    period: '2021 – 2026',
    title: 'Zespół Szkół Technicznych i Branżowych (ZSTiB)',
    subtitle: 'Technician Programmer',
    description: 'Built a solid foundation in programming, web technologies and problem solving.',
  },
  {
    Icon: GraduationCap,
    period: '2026 – Present',
    title: 'Wyższa Szkoła Kształcenia Zawodowego (WSKZ)',
    subtitle: "Bachelor's Degree in Cybersecurity",
    description:
      'Studying Cybersecurity and building practical skills in securing systems, networks, and applications.',
  },
];
---

<div class={styles.timelineContainer}>
  <Timeline data-orientation="vertical" id="education-card__timeline" class={styles.timeline}>
    {
      experiences.map(({ Icon, period, title, subtitle, description }) => (
        <TimelineItem>
          <Card class={styles.card}>
            <CardIcon Icon={Icon} />
            <div class={styles.content}>
              <Text className={styles.period} size="small">
                {period}
              </Text>
              <Heading as="h3" size="extra-small">
                {title}
              </Heading>
              {subtitle && (
                <Text size="extra-small" variant="secondary">
                  {subtitle}
                </Text>
              )}
              <Text className={styles.description} size="extra-small" variant="secondary">
                {description}
              </Text>
            </div>
          </Card>
        </TimelineItem>
      ))
    }
  </Timeline>
</div>

<script>
  import breakpoints from '@/styles/breakpoints.module.scss';

  const educationTimeline = document.querySelector<HTMLUListElement>('#education-card__timeline')!;
  const query = window.matchMedia(`(min-width: ${breakpoints.tablet})`);

  updateOrientation();

  query.addEventListener('change', () => {
    updateOrientation();
  });

  function updateOrientation() {
    educationTimeline.dataset.orientation = query.matches ? 'horizontal' : 'vertical';
  }
</script>
