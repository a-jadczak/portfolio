---
import Card from '@/components/ui/Card/Card.astro';
import styles from './WhatICareAboutCard.module.scss';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import { cards } from '../../data/values';
import CardIcon from '@/components/ui/CardIcon/CardIcon.astro';
---

<div class={styles.gridContainer}>
  {
    cards.map(({ title, Icon, description, image }) => (
      <Card class={styles.card} style={`--card-image: url("${image}")`}>
        <header>
          <CardIcon Icon={Icon} />
          <Heading className={styles.title} as="h3">
            {title}
          </Heading>
        </header>
        <Text variant="secondary">{description}</Text>
      </Card>
    ))
  }
</div>
