---
import Card from '@/components/ui/Card/Card.astro';
import CardIcon from '@/components/ui/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading';
import { MapPin, CircleCheck, Languages } from 'lucide-react';
import Text from '@/components/ui/Text/Text';
import styles from './AboutMeCard.module.scss';
import Divider from '@/components/ui/Divider/Divider';

const t = Astro.locals.i18n.t.pages.about.aboutMe;
---

<div class={styles.container}>
  <header class={styles.header}>
    <Heading as="h1" className={styles.title}>Arkadiusz Jadczak</Heading>
    <Text variant="secondary" size="small" className={styles.description}>
      {t.description}
      <br />
      {t.availability}
    </Text>
  </header>

  <Divider className={styles.divider} />
  <Card class={styles.card} border={false}>
    <ul class={styles.infoList}>
      <li class={styles.infoElement}>
        <CardIcon Icon={MapPin} class={styles.infoIcon} size={20} />
        <span class={styles.infoLabel}>{t.locationLabel}</span>
        <span class={styles.infoContent}>{t.location}</span>
      </li>
      <li class={styles.infoElement}>
        <CardIcon Icon={CircleCheck} class={styles.infoIcon} size={20} />
        <span class={styles.infoLabel}>{t.statusLabel}</span>
        <span class={styles.infoContent}>{t.status}</span>
      </li>
      <li class={styles.infoElement}>
        <CardIcon Icon={Languages} class={styles.infoIcon} size={20} />
        <span class={styles.infoLabel}>{t.languagesLabel}</span>
        <span class={styles.infoContent}>{t.languages}</span>
      </li>
    </ul>
  </Card>
</div>
