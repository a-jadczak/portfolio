---
import Card from '@/components/ui/Card/Card.astro';
import Eyebrow from '@/components/ui/Eyebrow/Eyebrow.astro';
import styles from './AboutCard.module.scss';

interface Props {
  eyebrow?: string;
  styles?: boolean;
}

const { eyebrow, styles: applyStyles = true } = Astro.props;
---

<Card class:list={[applyStyles && styles.card]} border={applyStyles}>
  <Eyebrow>{eyebrow}</Eyebrow>
  <slot />
</Card>
