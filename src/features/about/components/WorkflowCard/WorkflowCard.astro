---
import Card from '@/components/ui/Card/Card.astro';
import CardIcon from '@/components/ui/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import Timeline from '@/components/ui/Timeline/Timeline.astro';
import TimelineItem from '@/components/ui/Timeline/TimelineItem.astro';
import { CodeXml, FlaskConical, Lightbulb, MopSparkles, Palette } from 'lucide-react';
import styles from './WorkflowCard.module.scss';

const workflowCards = [
  {
    Icon: Lightbulb,
    title: 'Idea & Planning',
    description:
      'I start with an idea, research possible solutions, and plan application features, the tech stack, and design elements with the help of ChatGPT.',
  },
  {
    Icon: Palette,
    title: 'UI/UX Design',
    description: 'I experiment with generate visual concepts using AI before implementing them.',
  },
  {
    Icon: CodeXml,
    title: 'Development',
    description:
      'I turn plans and designs into working applications, using Trello to organize development tasks and track progress.',
  },
  {
    Icon: FlaskConical,
    title: 'Testing',
    description:
      'I test functionality, fix issues, and improve performance, accessibility, and user experience.',
  },
  {
    Icon: MopSparkles,
    title: 'Polishing & Final Touches',
    description:
      'I refine visual details, animations, and interactions to create a polished and consistent user experience.',
  },
];
---

<Timeline>
  {
    workflowCards.map(({ Icon, title, description }) => (
      <TimelineItem>
        <Card class={styles.card}>
          <CardIcon Icon={Icon} />
          <div>
            <Heading as="h3" size="small">
              {title}
            </Heading>
            <Text size="medium" variant="secondary">
              {description}
            </Text>
          </div>
        </Card>
      </TimelineItem>
    ))
  }
</Timeline>
