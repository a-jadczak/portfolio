---
import Card from '@/components/ui/Card/Card.astro';
import CardIcon from '@/components/ui/CardIcon/CardIcon.astro';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import Timeline from '@/components/ui/Timeline/Timeline.astro';
import TimelineItem from '@/components/ui/Timeline/TimelineItem.astro';
import {
  CodeXml,
  FlaskConical,
  Boxes,
  MessagesSquare,
  Palette,
  RefreshCw,
  Rocket,
} from 'lucide-react';
import styles from './WorkflowCard.module.scss';

const t = Astro.locals.i18n.t.pages.about.workflow;

const workflowCards = [
  { id: 'identify', Icon: MessagesSquare },
  { id: 'planning', Icon: Boxes },
  { id: 'design', Icon: Palette },
  { id: 'development', Icon: CodeXml },
  { id: 'testing', Icon: FlaskConical },
  { id: 'implementation', Icon: Rocket },
  { id: 'maintenance', Icon: RefreshCw },
] as const;
---

<Timeline>
  {
    workflowCards.map(({ id, Icon }) => (
      <TimelineItem>
        <Card class={styles.card}>
          <CardIcon Icon={Icon} />
          <div class={styles.content}>
            <Heading className={styles.title} as="h3" size="extra-small">
              {t[id].title}
            </Heading>
            <Text size="small" variant="secondary">
              {t[id].description}
            </Text>
          </div>
        </Card>
      </TimelineItem>
    ))
  }
</Timeline>
