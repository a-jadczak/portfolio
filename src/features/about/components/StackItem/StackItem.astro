---
import styles from './StackItem.module.scss';
const { title, accentColor = 'white', src } = Astro.props;
---

<div class={styles.item}>
  <div class={styles.imageCard} style={`--accent: ${accentColor}`}>
    <img class={styles.image} src={src} alt={`${title} icon`} />
  </div>
  <p class={styles.title}>{title}</p>
</div>
