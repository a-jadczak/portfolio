---
import Dialog from '@/components/ui/Dialog/Dialog';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text.astro';
import { SquareArrowOutUpRight } from 'lucide-react';
import styles from './ProjectDialog.module.scss';
import { ButtonLink } from '@/components/ui/Button/ButtonLink';
import { FaGithub } from 'react-icons/fa';
import Gallery from './components/Gallery/Gallery';
import YAML from 'yaml';
import { readFileSync } from 'node:fs';
import type { ProjectMetadata } from '@/types/ProjectMetadata';
//import { getFeaturedProjects, getProjects } from '@/lib/github';
import { parseProjectReadme } from './utils/parseProjectReadme';
import Readme from './components/Readme/Readme.astro';
import ProjectMeta from './components/ProjectMeta/ProjectMeta.astro';
import NavigationCarousel from './components/NavigationCarousel/NavigationCarousel.astro';

const PATH = './src/mocks/.github';
const content = readFileSync(`${PATH}/portfolio.yaml`, 'utf-8');
const metadata: ProjectMetadata = YAML.parse(content);

const readme = readFileSync(`./src/mocks/project-description.md`, 'utf-8');
const { headings, html } = parseProjectReadme(readme);

// console.log(JSON.stringify(await getFeaturedProjects(), null, 2));
// console.log(JSON.stringify(await getProjects(), null, 2));
---

<Dialog
  className={styles.dialog}
  id="project-dialog"
  title="Project / 01"
  closeLabel="Close project dialog"
  titleId="project-title"
>
  <div class={`clipped-corners ${styles.container}`}>
    <Heading as="h3">Project name</Heading>
    <Text variant="secondary" size="small">
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Maxime, repellendus!
    </Text>
    <ProjectMeta {metadata} />

    <ButtonLink className={styles.button} variant="primary" href="" target="_blank">
      <span>Live demo</span>
      <SquareArrowOutUpRight />
    </ButtonLink>
    <ButtonLink className={styles.button} variant="default" href="" target="_blank">
      <span>Github repository</span>
      <FaGithub />
    </ButtonLink>

    <Gallery banner={metadata.banner} gallery={metadata.gallery} client:idle />
  </div>

  {
    readme ? (
      <div class={`clipped-corners ${styles.container}`}>
        <NavigationCarousel {headings} />
        <Readme {html} />
      </div>
    ) : (
      <div class={`clipped-corners ${styles.container}`} style="text-align: center;">
        <Text variant="secondary">This project doesn't contain a description ☹️</Text>
      </div>
    )
  }
</Dialog>
