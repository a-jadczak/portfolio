---
import styles from './NavigationCarousel.module.scss';

interface Props {
  headings: string[];
}

const { headings } = Astro.props;
---

<nav aria-label="Projects sections" class={styles.navigation}>
  <ul id="navigation-carousel" class={styles.navigationCarousel}>
    {
      headings.map((heading) => (
        <li
          class={`clipped-corners ${styles.navigationCarouselItem}`}
          data-active="false"
          role="button"
        >
          <a href={`#${heading.toLowerCase().replace(' ', '-')}`}>{heading}</a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import type { Nullable } from '@/types/Nullable';

  const dialog = document.querySelector('#project-dialog')!;
  const headings = document.querySelectorAll('#readme h2');
  const navigationCarousel = document.querySelector('#navigation-carousel')!;
  let activeLink: Nullable<Element> = navigationCarousel.children[0];
  let currentActiveLink: Nullable<Element> = navigationCarousel.children[0];

  // Prevents Observer to override scrolling
  let isScrolling = false;

  navigationCarousel.querySelectorAll('li').forEach((e) =>
    e.addEventListener('click', () => {
      isScrolling = true;
    })
  );

  dialog.addEventListener('scrollend', () => {
    isScrolling = false;
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const targetHref = entry.target.id;

        currentActiveLink = navigationCarousel.querySelector(`li:has(a[href='#${targetHref}'])`);

        activeLink?.setAttribute('data-active', 'false');
        currentActiveLink?.setAttribute('data-active', 'true');

        activeLink = currentActiveLink;

        scrollToHeadingLink(activeLink);
      });
    },
    {
      root: null,
      rootMargin: '0px 0px -600px 0px',
      threshold: 1,
    }
  );

  function scrollToHeadingLink(target: Nullable<Element>) {
    if (isScrolling) return;

    target?.scrollIntoView({
      behavior: 'smooth',
      inline: 'nearest',
      block: 'nearest',
    });
  }

  headings?.forEach((heading) => observer.observe(heading));
</script>
