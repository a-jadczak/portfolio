---
import { ArrowRight } from 'lucide-react';
import styles from './FeaturedProjects.module.scss';
import Project from '@/features/projects/components/Project/Project';
import Heading from '@/components/ui/Heading/Heading.astro';
---

<section class={`clipped-corners ${styles.featuredProjects}`}>
  <div class={styles.titleContainer}>
    <Heading as="h2" size="small" class={styles.title}>Featured Projects</Heading>
    <a class={styles.link} href="/projects">
      <span>View all</span>
      <ArrowRight className={styles.buttonContentIcon} size={18} />
    </a>
  </div>
  <ol class={styles.projectsList}>
    <Project />
    <Project />
    <Project />
  </ol>
</section>
