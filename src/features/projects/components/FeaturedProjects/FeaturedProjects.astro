---
import { ArrowRight } from 'lucide-react';
import styles from './FeaturedProjects.module.scss';
import Project from '@/features/projects/components/Project/Project';
import Heading from '@/components/ui/Heading/Heading';
import { ButtonLink } from '@/components/ui/Button/ButtonLink';
import { getProjects } from '@/lib/github';

const { pinnedProjects, projects } = await getProjects();

const featuredProjects = projects.filter((project) =>
  pinnedProjects.some((pinned) => pinned.id === project.id)
);

featuredProjects.sort(
  (a, b) =>
    pinnedProjects.findIndex((p) => p.id === a.id) - pinnedProjects.findIndex((p) => p.id === b.id)
);
---

<section class={`clipped-corners ${styles.featuredProjects}`}>
  <div class={styles.titleContainer}>
    <Heading as="h2" size="small" className={styles.title}>Featured Projects</Heading>
    <ButtonLink variant="link" href="/projects">
      <span>View all</span>
      <ArrowRight size={18} aria-hidden="true" />
    </ButtonLink>
  </div>
  <ol class={styles.projectsList}>
    {featuredProjects.map((project) => <Project projectData={project} client:load />)}
  </ol>
</section>
