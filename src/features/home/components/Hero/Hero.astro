---
import { ButtonLink } from '@/components/ui/Button/ButtonLink';
import Eyebrow from '@/components/ui/Eyebrow/Eyebrow.astro';
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import styles from './Hero.module.scss';
import { ArrowUpRight, Mail } from 'lucide-react';
import ProfileImage from '../ProfileImage/ProfileImage.astro';
---

<section class={styles.section}>
  <ProfileImage />
  <div class={styles.infoContainer}>
    <header class={styles.intro}>
      <Eyebrow>Arkadiusz Jadczak · SOFTWARE ENGINEER</Eyebrow>
      <Heading as="h1" size="large">Building modern software.</Heading>
      <Text size="large" variant="secondary">
        I focus on building <span class={styles.blazinglyFast}>blazingly fast</span>, accessible and
        well-crafted web applications with clean, maintainable code.
      </Text>
    </header>

    <div class={styles.buttonContainer}>
      <ButtonLink href="/projects" variant="primary" className={styles.button}>
        <span>View Projects</span>
        <ArrowUpRight className={styles.icon} size={18} aria-hidden="true" />
      </ButtonLink>

      <ButtonLink href="/contact" variant="default" className={styles.button}>
        <span>Contact me</span>
        <Mail className={styles.icon} size={18} aria-hidden="true" />
      </ButtonLink>
    </div>
  </div>
</section>
