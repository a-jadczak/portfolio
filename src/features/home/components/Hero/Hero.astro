---
import Button from '@/components/ui/Button/Button';
import Eyebrow from '@/components/ui/Eyebrow/Eyebrow.astro';
import Heading from '@/components/ui/Heading/Heading.astro';
import Text from '@/components/ui/Text/Text.astro';
import styles from './Hero.module.scss';
import { ArrowRight, Mail } from 'lucide-react';
---

<section>
  <header class={styles.intro}>
    <Eyebrow>SOFTWARE ENGINEER · FRONT-END FOCUSED</Eyebrow>
    <Heading as="h1" size="large">Building modern software.</Heading>
    <Text size="large" variant="secondary">
      I focus on building <span class={styles.blazinglyFast}>blazingly fast</span>, accessible and
      well-crafted web applications with clean, maintainable code.
    </Text>
  </header>

  <Button
    as="a"
    href="/projects"
    variant="primary"
    text="View Projects"
    Icon={ArrowRight}
    style={{ margin: '0.5rem 0' }}
  />

  <Button as="a" href="/contact" variant="default" text="Contact me" Icon={Mail} />
</section>
