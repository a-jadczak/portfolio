---
import styles from './SettingsDialog.module.scss';
import { Settings } from 'lucide-react';
import ThemeControl from '@/features/settings/components/ThemeControl/ThemeControl';
import ColorPickerList from '@/features/settings/components/ColorPickerList/ColorPickerList';
import SettingsField from '@/features/settings/components/SettingsField/SettingsField.astro';
import Dialog from '@/components/ui/Dialog/Dialog';
import LanguageControl from '@/features/settings/components/LanguageControl/LanguageControl';
import Divider from '@/components/ui/Divider/Divider';
import Text from '@/components/ui/Text/Text';
import ResetSettingsButton from '@/features/settings/components/ResetSettingsButton/ResetSettingsButton';
import ReduceMotionControl from '@/features/settings/components/ReduceMotionControl/ReduceMotionControl';

const { lang, t } = Astro.locals.i18n;
---

<Dialog
  id="settings-dialog"
  title={t.settingsDialog.title}
  closeLabel={t.settingsDialog.closeLabel}
  titleId="settings-title"
  Icon={Settings}
>
  <Divider />
  <SettingsField title={t.settingsDialog.theme.label}>
    <ThemeControl lang={lang} client:load />
  </SettingsField>
  <SettingsField title={t.settingsDialog.language}>
    <LanguageControl lang={lang} client:load />
  </SettingsField>
  <div class={styles.toggleContainer}>
    <label>{t.settingsDialog.reduceMotion.label}</label>
    <ReduceMotionControl lang={lang} className={styles.toggle} client:load />
    <Text variant="secondary" size="extra-small">{t.settingsDialog.reduceMotion.description}</Text>
  </div>
  <Divider />
  <SettingsField title={t.settingsDialog.accentColor.label}>
    <ColorPickerList lang={lang} client:load />
  </SettingsField>
  <ResetSettingsButton client:load className={styles.systemPreferencesButton} variant="link">
    {t.settingsDialog.useSystemPreferences}
  </ResetSettingsButton>
</Dialog>
