---
import styles from './SettingsDialog.module.scss';
import { Moon, Settings, Sun } from 'lucide-react';
import ColorPickerList from '../components/ColorPickerList/ColorPickerList';
import SettingsField from '../components/SettingsField/SettingsField.astro';
import Dialog from '@/components/ui/Dialog/Dialog';
import SegmentedControl from '@/components/ui/SegmentedControl/SegmentedControl';
import Divider from '@/components/ui/Divider/Divider';
import Text from '@/components/ui/Text/Text';
import { Button } from '@/components/ui/Button/Button';
import Toggle from '@/components/ui/Toggle/Toggle';

const colors = ['red', 'lawngreen', 'blue', 'purple'];
---

<Dialog id="settings-dialog" title="Settings" titleId="settings-title" Icon={Settings}>
  <Divider />
  <SettingsField title="Theme">
    <SegmentedControl
      options={[
        { Icon: Sun, text: 'Light' },
        { Icon: Moon, text: 'Dark' },
      ]}
      value={'Dark'}
    />
  </SettingsField>
  <SettingsField title="Language">
    <SegmentedControl
      client:load
      options={[{ text: 'Polski' }, { text: 'English' }]}
      value={'English'}
    />
  </SettingsField>
  <div class={styles.toggleContainer}>
    <label>Reduce motion</label>
    <Toggle client:load aria-label="Reduce motion" className={styles.toggle} />
    <Text variant="secondary" size="small">Disable interface animations</Text>
  </div>
  <Divider />
  <!-- <SettingsField title="Reduce motion">

  </SettingsField> -->
  <SettingsField title="Accent color">
    <ColorPickerList client:load colors={colors} />
  </SettingsField>
  <Button variant="link">Use system preferences</Button>
</Dialog>
