---
import styles from './SettingsDialog.module.scss';
import { Settings } from 'lucide-react';
import ThemeControl from '@/features/settings/components/ThemeControl/ThemeControl';
import ColorPickerList from '@/features/settings/components/ColorPickerList/ColorPickerList';
import SettingsField from '@/features/settings/components/SettingsField/SettingsField.astro';
import Dialog from '@/components/ui/Dialog/Dialog';
import LanguageControl from '@/features/settings/components/LanguageControl/LanguageControl';
import { getLangFromUrl } from '@/i18n/utils';
import Divider from '@/components/ui/Divider/Divider';
import Text from '@/components/ui/Text/Text';
import { Button } from '@/components/ui/Button/Button';
import ReduceMotionControl from '@/features/settings/components/ReduceMotionControl/ReduceMotionControl';

const lang = getLangFromUrl(Astro.url);
---

<Dialog id="settings-dialog" title="Settings" titleId="settings-title" Icon={Settings}>
  <Divider />
  <SettingsField title="Theme">
    <ThemeControl client:load />
  </SettingsField>
  <SettingsField title="Language">
    <LanguageControl lang={lang} client:load />
  </SettingsField>
  <div class={styles.toggleContainer}>
    <label>Reduce motion</label>
    <ReduceMotionControl className={styles.toggle} client:load />
    <Text variant="secondary" size="extra-small">Disable interface animations</Text>
  </div>
  <Divider />
  <SettingsField title="Accent color">
    <ColorPickerList client:load />
  </SettingsField>
  <Button className={styles.systemPreferencesButton} variant="link">Use system preferences</Button>
</Dialog>
