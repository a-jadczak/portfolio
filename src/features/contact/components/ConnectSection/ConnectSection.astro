---
import { connections, type ConnectionId } from '@/features/contact/config/connections';
import ConnectionCard from '@/features/contact/components/ConnectionCard/ConnectionCard';
import styles from './ConnectSection.module.scss';
import Heading from '@/components/ui/Heading/Heading';

const connectionIds = Object.keys(connections) as ConnectionId[];
const { lang, t } = Astro.locals.i18n;
---

<section class={styles.container} data-ignore-padding>
  <Heading as="h2" size="small" className={styles.title}>{t.pages.contact.connect.title}</Heading>
  <ul class={styles.list}>
    {
      connectionIds.map((connectionId) => (
        <li>
          <ConnectionCard connectionId={connectionId} lang={lang} client:load />
        </li>
      ))
    }
  </ul>
</section>
