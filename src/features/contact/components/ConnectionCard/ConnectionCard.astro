---
import Heading from '@/components/ui/Heading/Heading';
import Text from '@/components/ui/Text/Text';
import styles from './ConnectionCard.module.scss';

const { icon: Icon, title, description, status } = Astro.props;
---

<div class={`clipped-corners ${styles.container} ${styles[status]}`}>
  <div class={`clipped-corners ${styles.iconContainer}`} aria-hidden={true}>
    <Icon size={32} />
  </div>
  <div class={styles.contentContainer}>
    <Heading as="h3" size="extra-small" className={styles.title}>{title}</Heading>
    <Text variant="secondary" size="small" className={styles.description}>{description}</Text>
  </div>
</div>
