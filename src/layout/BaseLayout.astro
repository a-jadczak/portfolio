---
import '@/styles/global.scss';
import styles from './BaseLayout.module.scss';
import Header from '@/components/Header/Header.astro';
import Footer from '@/components/Footer/Footer.astro';
import PageIndicator from '@/components/PageIndicator/PageIndicator.astro';
import { getCurrentPageInfo } from '@/data/pages';

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const currentPageInfo = getCurrentPageInfo(currentPath);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class={`${styles.main}`}>
      <PageIndicator pageInfo={currentPageInfo} />
      <slot />
    </main>
    <Footer />
  </body>
</html>
