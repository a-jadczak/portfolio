---
import { supportedLanguages } from '@/i18n/config';
import type { Language } from '@/types/Language';
import BaseLayout from '@/app/layouts/BaseLayout.astro';
import { getCurrentPageInfo, pages } from '@/config/pages';

export function getStaticPaths() {
  return supportedLanguages.flatMap((lang) =>
    pages
      .filter(({ href }) => href !== '/')
      .map(({ href }) => ({
        params: { lang, page: href.slice(1) },
      }))
  );
}

const { lang, page } = Astro.params as { lang: Language; page: string };

const currentPage = getCurrentPageInfo(`/${page}`);
const View = currentPage.view;
const { t } = Astro.locals.i18n;
---

<BaseLayout lang={lang} pageHref={currentPage.href} title={t.header.navigation[currentPage.name]}>
  <View />
</BaseLayout>
